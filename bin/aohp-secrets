#!/bin/bash
# aohp-secrets — choose and resolve how provider secrets reach the agent.
#   aohp-secrets setup [--method age|keystore|paste] [--age-identity F] [--passphrase-file F]   choose method, materialise
#   aohp-secrets env                                                      print 'export VAR=...' lines (used by launchers)
#   aohp-secrets migrate <age|keystore|paste>                             move existing secrets to another method
#   aohp-secrets required                                                 vars the launcher will resolve (explicit file or derived from openclaw.json)
#   aohp-secrets status
set -euo pipefail
OC_DIR=${OPENCLAW_HOME:-$HOME/.openclaw}; M="$OC_DIR/.secrets-method"; ENVF="$OC_DIR/.env"; REQ="$OC_DIR/secrets/required"
# Which env vars the gateway wants. Explicit list in $REQ wins; otherwise derived from openclaw.json
# (configured model providers + web search), falling back to ANTHROPIC_API_KEY. See 'aohp-secrets required'.
required() { if [ -f "$REQ" ]; then grep -vE '^\s*(#|$)' "$REQ"; else derived_required; fi; }
derived_required() {
  local cfg="$OC_DIR/openclaw.json"; [ -f "$cfg" ] && command -v python3 >/dev/null 2>&1 || { echo ANTHROPIC_API_KEY; return; }
  python3 - "$cfg" <<'PY' 2>/dev/null || echo ANTHROPIC_API_KEY
import json, sys
d = json.load(open(sys.argv[1]))
# provider id -> env var OpenClaw reads (mirrors CredentialBroker.KNOWN in aohp-driver; default <ID>_API_KEY)
env = {"anthropic":"ANTHROPIC_API_KEY","openai":"OPENAI_API_KEY","zai":"ZAI_API_KEY","perplexity":"PERPLEXITY_API_KEY",
       "gemini":"GEMINI_API_KEY","google":"GEMINI_API_KEY","groq":"GROQ_API_KEY","xai":"XAI_API_KEY","mistral":"MISTRAL_API_KEY",
       "deepseek":"DEEPSEEK_API_KEY","openrouter":"OPENROUTER_API_KEY","brave":"BRAVE_API_KEY","tavily":"TAVILY_API_KEY","github":"GITHUB_TOKEN"}
out = []
for pid in (d.get("models", {}).get("providers") or {}):
    if pid in ("local", "ollama"): continue                       # on-device, no key
    v = env.get(pid, pid.upper().replace("-", "_") + "_API_KEY"); v in out or out.append(v)
web = d.get("tools", {}).get("web", {}).get("webSearch") or {}
prov = (web.get("provider") or ("brave" if web else "")).lower()
if prov: v = env.get(prov, prov.upper() + "_API_KEY"); v in out or out.append(v)
plugins = d.get("plugins", {}).get("entries") or d.get("plugins", {}) or {}
if "github" in plugins and "GITHUB_TOKEN" not in out: out.append("GITHUB_TOKEN")
print("\n".join(out or ["ANTHROPIC_API_KEY"]))
PY
}
# var -> broker provider (cred-get). Rule: strip _API_KEY / _TOKEN / _OAUTH_TOKEN, lowercase; a few aliases.
secret_provider() {
  case "$1" in
    ANTHROPIC_AUTH_TOKEN|ANTHROPIC_OAUTH_TOKEN) echo anthropic;;
    Z_AI_API_KEY) echo zai;;
    GOOGLE_API_KEY) echo gemini;;
    *_API_KEY|*_TOKEN) local v="$1"; v=${v%_API_KEY}; v=${v%_OAUTH_TOKEN}; v=${v%_TOKEN}; echo "$v" | tr 'A-Z_' 'a-z-' ;;
    *) echo "";;
  esac
}
have_keystore() { command -v aohp >/dev/null 2>&1 && aohp secret list >/dev/null 2>&1; }
write_env() { umask 077; cat > "$ENVF"; chmod 600 "$ENVF"; }
tty_in() { [ -t 0 ] && return 0; [ -r /dev/tty ] && exec < /dev/tty && return 0; echo "  no terminal available for prompts — pass --passphrase-file / --token-file or run from the sandbox terminal"; exit 1; }

do_age() { local id=${1:-} ppf=${2:-}
  [ -f "$OC_DIR/secrets/env.age" ] || { echo "secrets/env.age not found in config repo"; exit 1; }
  if [ -n "$id" ]; then age -d -i "$id" "$OC_DIR/secrets/env.age" | write_env
  elif [ -n "$ppf" ]; then age-pass "$ppf" age -d "$OC_DIR/secrets/env.age" | write_env
  else tty_in; echo "  passphrase for secrets/env.age:"; age -d "$OC_DIR/secrets/env.age" | write_env; fi
  echo age > "$M"; }
do_paste() { tty_in; : | write_env
  for v in $(required); do printf '  %s: ' "$v"; read -rs val; echo; printf '%s=%s\n' "$v" "$val" >> "$ENVF"; done
  echo paste > "$M"; }
do_keystore() { have_keystore || { echo "keystore method needs an AgentDriver build with the secret store (aohp secret ...)"; exit 1; }
  for v in $(required); do aohp secret get "$v" >/dev/null 2>&1 || { tty_in; printf '  %s (stored in Android Keystore): ' "$v"; read -rs val; echo; printf '%s' "$val" | aohp secret set "$v"; }; done
  rm -f "$ENVF"; echo keystore > "$M"; }

case "${1:-}" in
  setup) shift; method=""; id=""; ppf=${AOHP_AGE_PASSPHRASE_FILE:-}
    while [ $# -gt 0 ]; do case "$1" in --method) method=$2; shift 2;; --age-identity) id=$2; shift 2;; --passphrase-file) ppf=$2; shift 2;; *) shift;; esac; done
    if [ -z "$method" ]; then
      if [ -f "$M" ] && [ -f "$ENVF" -o "$(cat "$M")" = keystore ]; then echo "  secrets already set up ($(cat "$M")); use 'aohp-secrets migrate' to change"; exit 0; fi
      tty_in; echo "  How should provider keys be stored?"
      [ -f "$OC_DIR/secrets/env.age" ] && echo "    1) age     — decrypt secrets/env.age from the repo (passphrase)"
      echo "    2) keystore — Android Keystore via the AgentDriver app $(have_keystore || echo '(not available in this app build)')"
      echo "    3) paste   — type the keys once"
      printf '  choice: '; read -r c; case "$c" in 1) method=age;; 2) method=keystore;; *) method=paste;; esac
    fi
    case "$method" in age) do_age "$id" "$ppf";; keystore) do_keystore;; paste) do_paste;; *) echo "unknown method $method"; exit 2;; esac
    echo "  secrets: $method";;
  env) m=$(cat "$M" 2>/dev/null || echo none)
    # base: the method chosen at bootstrap (age/paste -> .env, keystore -> aohp secret get)
    if [ -f "$ENVF" ]; then sed -nE 's/^([A-Za-z_][A-Za-z0-9_]*)=(.*)$/export \1="\2"/p' "$ENVF"
    elif [ "$m" = keystore ]; then for v in $(required); do printf 'export %s="%s"\n' "$v" "$(aohp secret get "$v")"; done; fi
    # §0 broker override (docs/CREDENTIALS.md): if the on-device credential broker has a provider
    # credential, prefer it — a later 'export' wins when eval'd. Broker absent/unreachable => no-op,
    # so the gateway starts identically off AOHP. OAuth tokens become ANTHROPIC_AUTH_TOKEN.
    if command -v cred-get >/dev/null 2>&1; then
      for v in $(required); do
        prov=$(secret_provider "$v"); [ -n "$prov" ] || continue
        line=$(cred-get "$prov" gateway_launch 2>/dev/null) || continue
        name=${line%%$'\t'*}; val=${line#*$'\t'}
        case "$name:$prov" in
          # Anthropic OAuth: the SDK wants the bearer token in ANTHROPIC_AUTH_TOKEN, not the API-key var.
          authorization:anthropic) printf 'unset %s\nexport ANTHROPIC_AUTH_TOKEN="%s"\n' "$v" "${val#Bearer }" ;;
          # Bearer-style API keys (openai, zai, perplexity, …): the env var holds the bare key.
          authorization:*)         printf 'export %s="%s"\n' "$v" "${val#Bearer }" ;;
          *)                       printf 'export %s="%s"\n' "$v" "$val" ;;
        esac
      done
    fi;;
  migrate) to=${2:?age|keystore|paste}; eval "$(aohp-secrets env)"
    case "$to" in
      keystore) have_keystore || { echo "keystore not available"; exit 1; }; for v in $(required); do printf '%s' "${!v:-}" | aohp secret set "$v"; done; [ -f "$ENVF" ] && shred -u "$ENVF"; echo keystore > "$M";;
      paste|age) : | write_env; for v in $(required); do printf '%s=%s\n' "$v" "${!v:-}" >> "$ENVF"; done; echo "$to" > "$M";;
    esac; echo "  secrets: $to";;
  required) echo "# $([ -f "$REQ" ] && echo "from $REQ" || echo "derived from $OC_DIR/openclaw.json (write $REQ to override)")"; required;;
  status) echo "method: $(cat "$M" 2>/dev/null || echo none); env file: $([ -f "$ENVF" ] && stat -c '%a %s bytes' "$ENVF" || echo none); required: $(required | tr '\n' ' ')";;
  *) sed -n '2,7p' "$0";;
esac
