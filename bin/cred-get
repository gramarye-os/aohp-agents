#!/usr/bin/env node
/*
 * cred-get — reference client for the AOHP credential broker (AF_UNIX @aohp_cred).
 * Canonical source: gramarye-os/aohp-driver clients/cred-get.js (docs/CREDENTIALS.md).
 * Prints  HEADER_NAME<TAB>HEADER_VALUE  on success. Exit: 0 ok, 3 denied/unconfigured,
 * 4 broker unreachable, 2 usage/protocol. Callers apply the §0 fallback on any non-zero.
 * Usage: cred-get <provider> [purpose]
 */
'use strict';
const net = require('net');
const provider = process.argv[2];
const purpose = process.argv[3] || 'cli';
if (!provider) { process.stderr.write('usage: cred-get <provider> [purpose]\n'); process.exit(2); }
const SOCKET = '\0aohp_cred';
const req = JSON.stringify({ id: String(Date.now()), method: 'cred.getToken', params: { provider, purpose } }) + '\n';
const sock = net.connect(SOCKET);
let buf = '', done = false;
const finish = (c) => { if (done) return; done = true; try { sock.destroy(); } catch (e) {} process.exit(c); };
sock.setTimeout(8000, () => { process.stderr.write('cred-get: timeout\n'); finish(4); });
sock.on('error', (e) => { process.stderr.write('cred-get: broker unreachable (' + e.code + ')\n'); finish(4); });
sock.on('connect', () => sock.write(req));
sock.on('data', (d) => {
  buf += d.toString('utf8');
  const nl = buf.indexOf('\n'); if (nl < 0) return;
  let msg; try { msg = JSON.parse(buf.slice(0, nl)); } catch (e) { process.stderr.write('cred-get: bad reply\n'); return finish(2); }
  if (!msg.ok) { const c = (msg.error && msg.error.code) || 'error'; process.stderr.write('cred-get: ' + c + '\n'); return finish(c === 'denied' || c === 'not_configured' || c === 'needs_reauth' ? 3 : 2); }
  const r = msg.result || {};
  if (!r.header_name || !r.header_value) { process.stderr.write('cred-get: empty token\n'); return finish(2); }
  process.stdout.write(r.header_name + '\t' + r.header_value + '\n'); finish(0);
});
