#!/bin/bash
# aohp-gateway — the OpenClaw gateway's network face for the Driver's Network card (and humans).
#
#   aohp-gateway status            JSON: tls, fingerprint, bind, urls per interface, pending/paired counts
#   aohp-gateway fingerprint       SHA-256 of the serving cert (what a browser should be told to expect)
#   aohp-gateway devices           JSON {pending:[…], paired:[…]} (openclaw devices list --json)
#   aohp-gateway approve [id]      approve a pending browser/app pairing (default: most recent)
#   aohp-gateway reject <id> | remove <id> | rename <id> <label>
#   aohp-gateway pair-url [iface]  https URL + fingerprint for a browser (default: wg0, else first LAN)
#   aohp-gateway setup-code        single-use OpenClaw mobile-app setup code (openclaw qr)
#   aohp-gateway pair-code [iface]  JSON {url, expiresAtMs, fingerprint}: an https URL carrying a 10-minute
#                                  bootstrap token in the fragment (#bootstrapToken=…, read by the Control UI, never
#                                  sent to the server). Scan it on a laptop -> Control UI -> pending device -> Allow.
#   aohp-gateway token             the shared gateway.auth token (for the manual login page); from the keystore
#   aohp-gateway cert [show]       JSON {cn, names, ips, notAfter, covers, missing}: what the serving cert is valid for
#   aohp-gateway cert regen [name] new self-signed cert, SAME key, CN=name, SANs = name, name.local, localhost and every
#                                  current non-cell address (wlan0/wg0/tailscale v4+v6); the gateway reloads it in ~1 s
#
# Everything talks to the gateway over loopback with the CLI's own auth (gateway.auth.token resolved
# from the env, see aohp-secrets). Exit: 0 ok; 1 usage; 2 gateway not reachable; 3 cli error.
set -u
export GIT_TERMINAL_PROMPT=0
PORT=$(openclaw config get gateway.port 2>/dev/null | tr -dc 0-9); PORT=${PORT:-18789}
TLSDIR=$HOME/.openclaw/gateway/tls
die(){ echo "aohp-gateway: $*" >&2; exit 1; }
oc(){ openclaw "$@" 2>&1 | grep -vE '^Config \('; return ${PIPESTATUS[0]}; }

fingerprint(){
  local c=$(openclaw config get gateway.tls.certPath 2>/dev/null | tr -d '"'); [ -f "$c" ] || c=$TLSDIR/gateway-cert.pem
  [ -f "$c" ] && openssl x509 -in "$c" -noout -fingerprint -sha256 2>/dev/null | cut -d= -f2
}
tls_on(){ [ "$(openclaw config get gateway.tls.enabled 2>/dev/null)" = true ]; }
addrs(){ ip -4 -o addr 2>/dev/null | awk '$2!="lo" && $2!~/^rmnet/ {split($4,a,"/"); print $2, a[1]}'; }
# every address a browser could reach us on: v4 + global v6, never lo or the cell interfaces (CGNAT / global v6 we do not serve on)
all_ips(){ ip -o addr 2>/dev/null | awk '$2!="lo" && $2!~/^rmnet/ && ($3=="inet" || ($3=="inet6" && $4!~/^fe80/)) {split($4,a,"/"); print a[1]}'; }
cert_json(){  # {cn, names, ips, notAfter, covers, missing} for the serving cert, or null
  local c=$TLSDIR/gateway-cert.pem; [ -f "$c" ] || { echo null; return; }
  python3 - "$(openssl x509 -in "$c" -noout -subject -enddate -ext subjectAltName 2>/dev/null)" "$(all_ips)" <<'PY'
import json, sys, re, ipaddress
def norm(a):
    try: return str(ipaddress.ip_address(a))   # openssl prints v6 expanded/uppercase, ip(8) compressed
    except ValueError: return a
txt, cur = sys.argv[1], [norm(a) for a in sys.argv[2].split()]
m = re.search(r'CN\s*=\s*([^,/\n]+)', txt); cn = m.group(1).strip() if m else ''
m = re.search(r'notAfter=(.*)', txt); na = m.group(1).strip() if m else ''
names = re.findall(r'DNS:([^,\s]+)', txt); ips = [norm(a) for a in re.findall(r'IP Address:([^,\s]+)', txt)]
missing = [i for i in cur if i not in ips]
print(json.dumps({'cn': cn, 'names': names, 'ips': ips, 'notAfter': na, 'covers': not missing, 'missing': missing}))
PY
}

case "${1:-}" in
  status)
    fp=$(fingerprint); scheme=$(tls_on && echo https || echo http)
    dev=$(oc devices list --json 2>/dev/null); [ -n "$dev" ] || dev='{}'
    python3 - "$scheme" "$PORT" "$fp" "$(openclaw config get gateway.bind 2>/dev/null | tr -d '"')" "$(openclaw config get gateway.auth.mode 2>/dev/null | tr -d '"')" "$dev" "$(addrs)" "$(cert_json)" <<'PY'
import json, sys
scheme, port, fp, bind, auth, dev, addrs, cert = sys.argv[1:9]
try: d = json.loads(dev)
except Exception: d = {}
urls = []
for line in addrs.splitlines():
    iface, ip = line.split()
    urls.append({'iface': iface, 'url': f'{scheme}://{ip}:{port}'})
import subprocess
def host_of(ip):
    """Best-effort reverse lookup (LAN DNS / hosts); '' when unknown. Capped at 1 s so status stays fast."""
    if not ip: return ''
    try:
        out = subprocess.run(['getent', 'hosts', ip], capture_output=True, text=True, timeout=1).stdout.split()
        return out[1] if len(out) > 1 and out[1] != ip else ''
    except Exception: return ''
def strip(p):
    q = {k: v for k, v in p.items() if k not in ('publicKey', 'tokens')}
    q['host'] = host_of(q.get('remoteIp'))
    return q
print(json.dumps({'tls': scheme == 'https', 'fingerprint': fp or None, 'bind': bind or 'loopback', 'auth': auth or 'none', 'port': int(port),
                  'urls': urls, 'pending': [strip(p) for p in d.get('pending', [])], 'paired': [strip(p) for p in d.get('paired', [])],
                  'cert': json.loads(cert or 'null')}))
PY
    ;;
  fingerprint) fp=$(fingerprint); [ -n "$fp" ] && echo "$fp" || { echo 'TLS is off (no certificate)' >&2; exit 3; } ;;
  devices) oc devices list --json ;;
  approve) shift; if [ -n "${1:-}" ]; then oc devices approve "$1"; else oc devices approve --latest; fi ;;
  reject)  [ -n "${2:-}" ] || die 'reject <deviceId>'; oc devices reject "$2" ;;
  remove)  [ -n "${2:-}" ] || die 'remove <deviceId>'; oc devices remove "$2" ;;
  rename)  [ -n "${3:-}" ] || die 'rename <deviceId> <label>'; oc devices rename "$2" "$3" ;;
  pair-url)
    want=${2:-wg0}; ip=$(addrs | awk -v w="$want" '$1==w{print $2; exit}'); [ -n "$ip" ] || ip=$(addrs | awk '{print $2; exit}')
    [ -n "$ip" ] || die 'no non-loopback address'
    printf '%s://%s:%s\n' "$(tls_on && echo https || echo http)" "$ip" "$PORT"; fp=$(fingerprint); [ -n "$fp" ] && echo "cert sha256 $fp" ;;
  setup-code) oc qr --setup-code-only ;;
  pair-code)
    want=${2:-wlan0}; ip=$(addrs | awk -v w="$want" '$1==w{print $2; exit}'); [ -n "$ip" ] || ip=$(addrs | awk '{print $2; exit}')
    [ -n "$ip" ] || die 'no non-loopback address'
    sc=$(oc qr --setup-code-only 2>/dev/null | tail -1); [ -n "$sc" ] || die 'could not mint a setup code (gateway up?)'
    python3 - "$sc" "$ip" "$PORT" "$(tls_on && echo https || echo http)" "$(fingerprint)" "$want" <<'PY'
import sys, json, base64, urllib.parse
sc, ip, port, scheme, fp, want = sys.argv[1:7]
p = json.loads(base64.urlsafe_b64decode(sc + "=" * (-len(sc) % 4)))
tok = p.get("bootstrapToken") or ""
if not tok: sys.exit("setup code has no bootstrapToken")
print(json.dumps({"url": f"{scheme}://{ip}:{port}/#bootstrapToken={urllib.parse.quote(tok, safe='')}", "expiresAtMs": p.get("expiresAtMs"), "fingerprint": fp or None, "iface": want}))
PY
    ;;
  token) aohp secret get GATEWAY_AUTH_TOKEN 2>/dev/null || die 'no GATEWAY_AUTH_TOKEN in the keystore' ;;
  cert)
    case "${2:-}" in
      ""|show) cert_json ;;
      regen)
        # OpenClaw's autoGenerate cert is CN=openclaw-gateway with no subjectAltName, so no browser can ever match it to
        # a host. Re-issue on the same key naming this phone and its addresses; the gateway's watchFile picks the new
        # file up without a restart (server-tls-renewal.ts). The fingerprint changes: pins must be re-accepted.
        name=$(printf '%s' "${3:-$(cat /etc/hostname 2>/dev/null)}" | tr 'A-Z' 'a-z' | tr -d ' ' | tr -c 'a-z0-9-' '-' | sed 's/^-*//; s/-*$//'); [ -n "$name" ] || name=aohp
        san="DNS:$name,DNS:$name.local,DNS:localhost,IP:127.0.0.1"; for ip in $(all_ips); do san="$san,IP:$ip"; done
        mkdir -p "$TLSDIR" && chmod 700 "$TLSDIR"
        [ -f "$TLSDIR/gateway-key.pem" ] || (umask 077; openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out "$TLSDIR/gateway-key.pem" 2>/dev/null) || die 'could not generate a key'
        (umask 077; openssl req -x509 -new -key "$TLSDIR/gateway-key.pem" -subj "/CN=$name" -days 3650 -addext "subjectAltName=$san" \
            -addext 'basicConstraints=critical,CA:FALSE' -addext 'extendedKeyUsage=serverAuth' -addext 'keyUsage=digitalSignature,keyEncipherment' \
            -out "$TLSDIR/gateway-cert.pem.new" 2>/dev/null) || { rm -f "$TLSDIR/gateway-cert.pem.new"; die 'openssl req failed'; }
        mv -f "$TLSDIR/gateway-cert.pem.new" "$TLSDIR/gateway-cert.pem"
        cert_json ;;
      *) die 'cert [show|regen [name]]' ;;
    esac ;;
  *) sed -n '2,11p' "$0"; exit 1 ;;
esac
